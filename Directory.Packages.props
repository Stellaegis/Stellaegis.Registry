<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Stellaegis: the Microsoft.Extensions abstractions come with Stellaegis.Primitives.Hosting -->
    <PackageVersion Include="Stellaegis.Primitives" Version="5.1.0" />
    <PackageVersion Include="Stellaegis.Primitives.Hosting" Version="5.1.0" />
    <PackageVersion Include="Stellaegis.Primitives.Data" Version="5.1.0" />
    <PackageVersion Include="Stellaegis.Primitives.AspNetCore" Version="5.1.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <!-- The rest of the base, for the example host under samples/ only: the registry references none of them -->
    <PackageVersion Include="Stellaegis.Identity" Version="5.1.0" />
    <PackageVersion Include="Stellaegis.Identity.PostgreSQL" Version="5.1.0" />
    <PackageVersion Include="Stellaegis.Identity.AspNetCore" Version="5.1.0" />
    <PackageVersion Include="Stellaegis.Identity.Server" Version="5.1.0" />
    <PackageVersion Include="Stellaegis.Issuer" Version="5.0.0" />
    <PackageVersion Include="Stellaegis.Issuer.PostgreSQL" Version="5.0.0" />
    <PackageVersion Include="Stellaegis.Issuer.Client" Version="5.0.0" />
    <PackageVersion Include="Stellaegis.Issuer.Server" Version="5.0.0" />
    <PackageVersion Include="Stellaegis.Access" Version="5.0.0" />
    <PackageVersion Include="Stellaegis.Access.PostgreSQL" Version="5.0.0" />
    <PackageVersion Include="Stellaegis.Access.AspNetCore" Version="5.0.0" />
    <!-- PostgreSQL -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- Testing -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>
</Project>
