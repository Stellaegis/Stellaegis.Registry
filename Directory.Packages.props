<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Stellaegis: the Microsoft.Extensions abstractions come with Stellaegis.Primitives.Hosting -->
    <PackageVersion Include="Stellaegis.Primitives" Version="5.6.0" />
    <PackageVersion Include="Stellaegis.Primitives.Hosting" Version="5.6.0" />
    <PackageVersion Include="Stellaegis.Primitives.Data" Version="5.6.0" />
    <PackageVersion Include="Stellaegis.Primitives.AspNetCore" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <!-- The rest of the base, for the example host under samples/; the registry references none of them, the composition package Stellaegis.Identity alone -->
    <PackageVersion Include="Stellaegis.Identity" Version="9.0.1" />
    <PackageVersion Include="Stellaegis.Identity.PostgreSQL" Version="9.0.1" />
    <PackageVersion Include="Stellaegis.Identity.AspNetCore" Version="9.0.1" />
    <PackageVersion Include="Stellaegis.Identity.Server" Version="9.0.1" />
    <PackageVersion Include="Stellaegis.Issuer" Version="5.4.1" />
    <PackageVersion Include="Stellaegis.Issuer.PostgreSQL" Version="5.4.1" />
    <PackageVersion Include="Stellaegis.Issuer.Client" Version="5.4.1" />
    <PackageVersion Include="Stellaegis.Issuer.Server" Version="5.4.1" />
    <PackageVersion Include="Stellaegis.Access" Version="6.1.0" />
    <PackageVersion Include="Stellaegis.Access.PostgreSQL" Version="6.1.0" />
    <PackageVersion Include="Stellaegis.Access.AspNetCore" Version="6.1.0" />
    <!-- PostgreSQL -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- SQL Server -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Pinned above what Microsoft.Data.SqlClient brings, 9.0.x: CVE-2026-84008, fixed in 10.0.13 -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- Testing -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>
</Project>
