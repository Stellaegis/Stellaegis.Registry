<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The example host of Stellaegis.Registry, and the first assembly of the whole family's base: an enterprise
       application — one compartment, the company — holding its accounts (Identity), issuing its tokens (Issuer),
       deciding its rights (Access) and giving them their meaning (Registry), in one process, with a module of its
       own. The three other packages come from NuGet; the registry is this repository. Not a package, never packed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Registry.Sample</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <UserSecretsId>stellaegis-registry-sample</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Stellaegis.Registry\Stellaegis.Registry.csproj" />
    <ProjectReference Include="..\..\src\Stellaegis.Registry.PostgreSQL\Stellaegis.Registry.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\src\Stellaegis.Registry.AspNetCore\Stellaegis.Registry.AspNetCore.csproj" />
    <!-- The rest of the base comes as packages: the registry references none of them, the host composes the four. -->
    <PackageReference Include="Stellaegis.Identity" />
    <PackageReference Include="Stellaegis.Identity.PostgreSQL" />
    <PackageReference Include="Stellaegis.Identity.AspNetCore" />
    <PackageReference Include="Stellaegis.Identity.Server" />
    <PackageReference Include="Stellaegis.Issuer" />
    <PackageReference Include="Stellaegis.Issuer.PostgreSQL" />
    <PackageReference Include="Stellaegis.Issuer.Client" />
    <PackageReference Include="Stellaegis.Issuer.Server" />
    <PackageReference Include="Stellaegis.Access" />
    <PackageReference Include="Stellaegis.Access.PostgreSQL" />
    <PackageReference Include="Stellaegis.Access.AspNetCore" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

</Project>
