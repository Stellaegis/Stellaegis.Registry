<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Registry.SqlServer</RootNamespace>
    <PackageId>Stellaegis.Registry.SqlServer</PackageId>
    <Description>The SQL Server stores of Stellaegis.Registry: the compartments, the users, the catalogue of operations, the roles, the memberships and the operators in the schema reg, with the declaration of the database for its installation and its verification at startup.</Description>
    <PackageTags>stellaegis;registry;roles;memberships;sqlserver;dapper</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- Pinned above the vulnerable version Microsoft.Data.SqlClient pulls in; see Directory.Packages.props -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Stellaegis.Primitives.Data" />
    <ProjectReference Include="..\Stellaegis.Registry\Stellaegis.Registry.csproj" />
    <InternalsVisibleTo Include="Stellaegis.Registry.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sql\**\*.sql" />
  </ItemGroup>

</Project>
