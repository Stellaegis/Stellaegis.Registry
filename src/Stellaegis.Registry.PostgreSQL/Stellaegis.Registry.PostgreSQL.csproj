<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Registry.PostgreSQL</RootNamespace>
    <PackageId>Stellaegis.Registry.PostgreSQL</PackageId>
    <Description>The PostgreSQL stores of Stellaegis.Registry: the compartments, the users, the catalogue of operations, the roles, the memberships and the operators in the schema reg, with the declaration of the database for its installation and its verification at startup.</Description>
    <PackageTags>stellaegis;registry;roles;memberships;postgresql;dapper</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Stellaegis.Primitives.Data" />
    <ProjectReference Include="..\Stellaegis.Registry\Stellaegis.Registry.csproj" />
    <InternalsVisibleTo Include="Stellaegis.Registry.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sql\**\*.sql" />
  </ItemGroup>

</Project>
